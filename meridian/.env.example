# Copy this file to .env and fill in the values.
# Do not commit .env. Do not email API keys.

DATABASE_URL=postgresql://meridian_app:choose-a-long-password@127.0.0.1:5432/meridian

# Required in production (at least 32 characters). It encrypts model API keys saved on the Connect AI page.
# The app refuses to start that feature without it when NODE_ENV=production.
# Generate one:  openssl rand -base64 48
# Changing it later makes previously saved model keys unreadable. Paste them again.
APP_SECRET=

# Set to 1 ONLY when the app runs behind a reverse proxy that sets X-Forwarded-For (or X-Real-IP) and
# strips any client-supplied value. Enables the per-address sign-in throttle. Leave unset otherwise.
# TRUST_PROXY=1

# Optional. You can also paste keys on the Connect AI page.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Optional offline drafting through a local Ollama model. Example only; nothing is sent off this machine.
# Needs no key. A 127.0.0.1 or localhost address is the only kind that is allowed for restricted engagements.
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.1:8b
