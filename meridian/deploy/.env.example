# Copy to deploy/.env (chmod 600). Never commit deploy/.env. No real values here.

# Database password. Generate: openssl rand -base64 36 | tr -d '/+=' 
POSTGRES_PASSWORD=
POSTGRES_USER=meridian_app
POSTGRES_DB=meridian

# Encrypts saved model keys (min 32 chars). Generate: openssl rand -base64 48
# Changing it later makes saved model keys unreadable (paste them again).
APP_SECRET=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Screens may differ.
TUNNEL_TOKEN=

# Backups: passphrase for gpg encryption. Generate: openssl rand -base64 48
# Store a copy OFF the server (password manager). Without it backups cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_KEEP=14

# Optional off-box copy of backups (leave blank to skip). Needs rclone configured on the host.
RCLONE_REMOTE=

# Optional model keys (can also be pasted in the app screen). Leave blank if unused.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model overrides and OpenAI-compatible provider (keys can instead be entered in Connect AI)
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Private network used by the stack and the Cloudflare tunnel route. Defaults shown.
# If you change these, use the same subnet in the Cloudflare private network route and WARP split tunnels.
MERIDIAN_SUBNET=172.30.0.0/24
MERIDIAN_IP=172.30.0.10
